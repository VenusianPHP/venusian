{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "venusian/venusian",
    "type": "project",
    "description": "The skeleton application for the Venusian framework.",
    "keywords": [
        "scrapyard-io",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "venusian/framework": "^0.8.0",
        "venusian/probe": "^0.8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "guzzlehttp/psr7": "^2.0",
        "league/flysystem-path-prefixing": "^3.25.1",
        "league/flysystem-read-only": "^3.25.1",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout"
        ],
        "test": [
            "@php vendor/bin/pest"
        ],
        "post-autoload-dump": [
            "Voyager\\System\\ComposerScripts::postAutoloadDump",
            "@php computer package:discover --ansi"
        ],
        "post-update-cmd": [],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [],
        "pre-package-uninstall": [
            "Voyager\\System\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "scrapyard-io": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
