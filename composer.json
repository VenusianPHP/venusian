{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "venusian/venusian",
    "type": "project",
    "description": "The skeleton application for the Venusian framework.",
    "keywords": [
        "venusian",
        "framework",
        "skeleton"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "venusian/framework": "^0.10.0",
        "venusian/probe": "^0.10.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@post-root-package-install",
            "@post-create-project-cmd"
        ],
        "test": [
            "@php vendor/bin/pest"
        ],
        "post-autoload-dump": [
            "Voyager\\Core\\ComposerScripts::postAutoloadDump",
            "@php computer package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php -r \"file_put_contents('.env', preg_replace('/^APP_KEY=(?=\\R)/m', 'APP_KEY=base64:'.base64_encode(random_bytes(32)), file_get_contents('.env')));\"",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\""
        ]
    },
    "extra": {
        "venusian": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
